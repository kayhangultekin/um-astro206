% ---------------------------------------------------------------------------
% Lecture 6 (light, Doppler beaming, seeing black holes).
%
% All three DOIs verified against Crossref metadata 2026-09-09 -- title,
% journal, volume, page and year read back from the API rather than typed
% from memory.
%
% The EHT papers carry 349 and 389 individual authors. Crossref lists the
% collaboration as the first author on the Sgr A* paper and leaves it blank on
% the M87 one; a corporate author is used for both, which is how AAS itself
% renders them and the only form a reading list can use.
%
% JAMES ET AL. IS THE ONE TO READ, and it is the licensing pivot too: the
% PUBLISHED version is open access under CC BY 3.0 (verified at the IOP
% article page), so its figures are reusable with attribution. The arXiv
% preprint of the same paper is CC BY-NC-SA 3.0 -- a DIFFERENT and more
% restrictive license. If a figure from this paper is ever reproduced here,
% the pixels must come from the published version, not from arXiv.
%
% Its figure 15 is the three-panel sequence the lecture is built around:
%   (a) the disk with no shifts at all
%   (b) the same disk with its colors Doppler and gravitationally shifted
%   (c) the same disk with its specific intensity also shifted, I_nu ~ nu^3
% -- which is the beaming exponent, stated by the authors themselves, and the
% same three states the widget's toggle is designed to step through.
% ---------------------------------------------------------------------------

@article{james2015,
  author  = {James, Oliver and von Tunzelmann, Eug{\'e}nie and
             Franklin, Paul and Thorne, Kip S.},
  title   = {Gravitational Lensing by Spinning Black Holes in Astrophysics,
             and in the Movie {Interstellar}},
  journal = {Classical and Quantum Gravity},
  volume  = {32},
  number  = {6},
  pages   = {065001},
  year    = {2015},
